{
  "agy-switch-auto-rotate": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 /srv/agy-workspaces/booster/agy-switcher/scripts/agy_switch.py hook-pre-invocation",
        "timeout": 5
      }
    ]
  },
  "build-quality-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "bash /srv/agy-workspaces/booster/agy-switcher/scripts/verify-build.sh",
        "timeout": 45
      }
    ]
  }
}
